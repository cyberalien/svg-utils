		"*.d.ts"
	],
	"dependencies": {
		"@iconify/types": "^2.0.0"
	},
	"devDependencies": {
		"@iconify-json/ri": "^1.2.10",
		"@types/node": "^25.5.2",
		"oxlint": "^1.58.0",
		"tsdown": "^0.21.7",
		"typescript": "^5.9.3",
		"vitest": "^4.1.2"
	}
}
